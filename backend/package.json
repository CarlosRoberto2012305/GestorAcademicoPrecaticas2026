{
	"name": "GetsorAcademico",
	"version": "1.0.0",
	"description": "API REST del sistema de calificacion de cursos - USAC",
	"main": "src/server.js",
	"type": "commonjs",
	"scripts": {
		"start": "node src/server.js",
		"dev": "nodemon src/server.js",
		"start:pm2": "pm2 start src/server.js --name gestor-academico-api --update-env",
		"stop:pm2": "pm2 stop gestor-academico-api",
		"restart:pm2": "pm2 restart gestor-academico-api --update-env",
		"logs:pm2": "pm2 logs gestor-academico-api"
	},
	"dependencies": {
		"bcrypt": "^6.0.0",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.7.0",
		"express-validator": "^7.3.2",
		"helmet": "^8.3.0",
		"jsonwebtoken": "^9.0.3",
		"mysql2": "^3.12.0",
		"sequelize": "^6.37.8"
	},
	"devDependencies": {
		"nodemon": "^3.1.14",
		"pm2": "^7.0.4"
	}
}
